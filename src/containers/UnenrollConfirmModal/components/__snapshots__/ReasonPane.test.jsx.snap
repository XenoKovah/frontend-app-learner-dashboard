// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`UnenrollConfirmModal ReasonPane snapshot 1`] = `
<Fragment>
  <h4>
    What are your reasons for unenrolling?
  </h4>
  <Form.CheckboxSet
    name="unenrollReason"
    onChange={[MockFunction props.reason.selectOption]}
    value={
      [
        "props.reason.selected",
      ]
    }
  >
    <Form.Checkbox
      key="zeroCompletion"
      value="zeroCompletion"
    >
      I needed to unenroll from a 0%-completion class to register for new classes
    </Form.Checkbox>
    <Form.Checkbox
      key="time"
      value="time"
    >
      I don't have the time
    </Form.Checkbox>
    <Form.Checkbox
      key="browse"
      value="browse"
    >
      I just wanted to browse the material (but I didn't know I don't need to enroll to browse, but I do now!)
    </Form.Checkbox>
    <Form.Checkbox
      key="easy"
      value="easy"
    >
      The course material was too easy
    </Form.Checkbox>
    <Form.Checkbox
      key="difficulty"
      value="difficulty"
    >
      The course material was too hard
    </Form.Checkbox>
    <Form.Checkbox
      key="quality"
      value="quality"
    >
      I'm not happy with the quality of the content
    </Form.Checkbox>
    <Form.Checkbox
      key="goals"
      value="goals"
    >
      This course isn't aligned with my goals
    </Form.Checkbox>
    <Form.Checkbox
      key="support"
      value="support"
    >
      I don't have enough support
    </Form.Checkbox>
    <Form.Checkbox
      value="broken"
    >
      <Form.Control
        onChange={[MockFunction props.reason.brokenOption.onChange]}
        placeholder="Something was broken"
        value="props.reason.brokenOption.value"
      />
    </Form.Checkbox>
    <Form.Checkbox
      value="custom"
    >
      <Form.Control
        onChange={[MockFunction props.reason.customOption.onChange]}
        placeholder="Other"
        value="props.reason.customOption.value"
      />
    </Form.Checkbox>
  </Form.CheckboxSet>
  <ActionRow>
    <Button
      onClick={[MockFunction props.reason.handleSkip]}
      variant="tertiary"
    >
      Skip survey
    </Button>
    <Button
      disabled={false}
      onClick={[MockFunction props.reason.handleSubmit]}
    >
      Submit reason
    </Button>
  </ActionRow>
</Fragment>
`;

